# Family Veda — environment variable template
# Copy to .env and fill in locally. NEVER commit .env.
# Reference: docs/ENV_VARS.md

# ── Backend: database ──────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=familyveda;Username=CHANGE_ME;Password=CHANGE_ME
ASPNETCORE_ENVIRONMENT=Development
Database__MigrateOnStartup=false
Seed__Enabled=false
Seed__DefaultPassword=CHANGE_ME

# ── Backend: JWT ───────────────────────────────────────────
# Jwt__Key is a SECRET. Generate a long random value; never reuse across environments.
Jwt__Issuer=familyveda
Jwt__Audience=familyveda-clients
Jwt__Key=CHANGE_ME
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# ── Backend: CORS ──────────────────────────────────────────
Cors__AllowedOrigins=http://localhost:5173

# ── Backend: LLM provider chain (Gemini -> Groq -> Cloudflare) ───
# Gemini is primary; Groq and Cloudflare are bounded fallbacks.
# Optional key pool: Gemini__ApiKeys__0=... and Gemini__ApiKeys__1=...
# Keys are server-only secrets. Each provider gets at most one retry.
Gemini__ApiKey=CHANGE_ME
Gemini__Model=gemini-3.5-flash
Gemini__TimeoutSeconds=45

Llm__Provider=openai-compatible
Llm__BaseUrl=https://api.groq.com/openai/v1
Llm__Model=openai/gpt-oss-20b
Llm__ApiKey=CHANGE_ME
Llm__TimeoutSeconds=30

Cloudflare__AccountId=
Cloudflare__ApiKey=
Cloudflare__Model=@cf/meta/llama-3.1-8b-instruct-fp8
Cloudflare__TimeoutSeconds=30

# ── Backend: agent behaviour ───────────────────────────────
Agents__ConfidenceThreshold=0.60

# ── Backend: OCR ───────────────────────────────────────────
Ocr__Engine=Tesseract
Ocr__TesseractDataPath=./tessdata
Ocr__TimeoutSeconds=30
Ocr__MaxConcurrentProcesses=2
Ocr__MaxOutputCharacters=250000

# ── Backend: file storage ──────────────────────────────────
# Database (default) or GoogleDrive — see docs/adr/ADR-014-google-drive-report-storage.md
Storage__Provider=Database
Storage__LabReportPath=./storage/lab-reports
Storage__MaxUploadBytes=10485760
# Filled by scripts/google-drive-authorize.py. Leave empty to keep images in PostgreSQL.
GoogleDrive__ClientId=
GoogleDrive__ClientSecret=
GoogleDrive__RefreshToken=
DataProtection__KeysPath=./storage/data-protection-keys

# ── Backend: notifications (third-party, backend-only) ─────
# Fcm__ServiceAccountJson is a SECRET JSON object supplied as one environment value.
Fcm__ServiceAccountJson=CHANGE_ME
Fcm__ProjectId=CHANGE_ME

# Twilio SMS fallback — optional. Both values are SECRETS.
Twilio__AccountSid=
Twilio__AuthToken=
Twilio__FromNumber=

# ── Backend: clinical workflow timings ─────────────────────
Sla__DoctorResponseHours=6
Grants__ExpiryHours=48

# ── Web (Vite) ─────────────────────────────────────────────
# WARNING: every VITE_* value is inlined into the client bundle. Never put a secret here.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_ENV=development

# ── Mobile (Flutter) ───────────────────────────────────────
# Passed at build time with --dart-define, not read from this file.
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5000/api/v1 --dart-define=APP_ENV=development

# Android release signing (local/CI only; never commit the keystore)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
