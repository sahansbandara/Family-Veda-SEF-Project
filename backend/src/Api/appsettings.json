{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "familyveda",
    "Audience": "familyveda-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.1:8b",
    "TimeoutSeconds": 45
  },
  "Agents": {
    "ConfidenceThreshold": 0.60
  },
  "Ocr": {
    "Engine": "Tesseract",
    "TesseractDataPath": "./tessdata",
    "TimeoutSeconds": 30
  },
  "Storage": {
    "LabReportPath": "./storage/lab-reports",
    "MaxUploadBytes": 10485760
  },
  "Sla": {
    "DoctorResponseHours": 6
  },
  "Grants": {
    "ExpiryHours": 48
  },
  "AllowedHosts": "*"
}
