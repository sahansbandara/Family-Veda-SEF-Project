{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "familyveda",
    "Audience": "familyveda-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Agents": {
    "ConfidenceThreshold": 0.60
  },
  "Ocr": {
    "Engine": "Tesseract",
    "TesseractDataPath": "./tessdata",
    "DeskewCommand": "magick",
    "PdfRenderCommand": "pdftoppm",
    "MaxPages": 4,
    "MaxOutputCharacters": 60000,
    "TimeoutSeconds": 30,
    "TotalTimeoutSeconds": 150
  },
  "Storage": {
    "Provider": "Database",
    "LabReportPath": "./storage/lab-reports",
    "MaxUploadBytes": 10485760
  },
  "Sla": {
    "DoctorResponseHours": 6
  },
  "Grants": {
    "ExpiryHours": 48
  },
  "AllowedHosts": "*"
}
